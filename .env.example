# =============================================================================
# Nightfall - environment configuration
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Database (required) -----------------------------------------------------
# For Vercel/serverless, use the Supabase shared transaction-pooler URL:
# postgresql://postgres.<project-ref>:<URL-ENCODED-password>@aws-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# The application uses drizzle-orm/pg-core with postgres-js and disables prepared
# statements, as transaction pooling requires. Do not provide a MySQL URL.
DATABASE_URL=postgresql://postgres.project-ref:password@aws-1-region.pooler.supabase.com:6543/postgres?sslmode=require

# --- Auth / session (required) ----------------------------------------------
# Secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
COOKIE_SECRET=

# 32-byte base64 key used to wrap per-student encryption keys. Keep the same
# value across deployments: rotating it without a controlled key migration
# makes existing student Gemini BYOK keys and encrypted Gmail tokens unreadable.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

# --- Scheduler (free external POST trigger) ----------------------------------
# Shared secret required by POST /api/cron/deadline-nudges and
# POST /api/cron/source-watches. Configure cron-job.org with
# Authorization: Bearer <this value>; never put this secret in a URL.
CRON_SECRET=

# --- AI (required for consultant / essay / briefings / reply classification) -
# Optional service fallback. Per-student Gemini-compatible BYOK remains the
# preferred live key when the student has supplied one in Settings.
GEMINI_API_KEY=

# --- Google account sign-in --------------------------------------------------
# Optional dedicated values for "Sign in with Google". In the initial release,
# Nightfall falls back to the configured GMAIL_* OAuth client if these are absent.
# Register the separate account sign-in callback in that same Google OAuth client:
# https://<deployment-host>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gmail integration (required only for university email send/sync) -------
# From Google Cloud Console -> OAuth client.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# 32+ character secret used to encrypt stored refresh tokens at rest.
GMAIL_TOKEN_ENCRYPTION_KEY=
# Public URL of this deployment, used to build the OAuth redirect URI.
APP_URL=http://localhost:3000

# --- Durable private object storage (required for Vercel uploads) ------------
# Use S3, Cloudflare R2, Supabase Storage's S3 compatibility endpoint, or an
# equivalent S3-compatible provider. Objects remain private; Nightfall issues
# short-lived signed read URLs only after session and owner/admin checks.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for S3-compatible providers. Omit for AWS S3.
S3_ENDPOINT=
# Set true only when the provider requires path-style addressing.
S3_FORCE_PATH_STYLE=false

# --- Runtime -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# =============================================================================
# After filling this in:
#   pnpm run db:push                                # create/migrate Postgres tables
#   npx tsx scripts/ingest-programme-directories.ts # load DE v4 + IT v1 data
#                                                   # (put the two XLSX files
#                                                   #  in the project root, or
#                                                   #  set GERMANY_DIRECTORY_PATH
#                                                   #  / ITALY_DIRECTORY_PATH)
#   $env:NODE_ENV="development"; npx tsx watch server/_core/index.ts
#
# The FIRST account you register becomes the admin (sees Admin Intake).
# =============================================================================
